{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "图标提取器",
  "version": "0.1.0",
  "identifier": "com.derek.icon-extractor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "图标提取器",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/to-ico.png",
      "icons/icon.ico"
    ]
  }
}
